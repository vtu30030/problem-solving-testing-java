import java.io.*;
import java.util.*;

public class Solution {

    public static List<Integer> maxSubarray(List<Integer> arr) {

        int current = arr.get(0);
        int maxSubarray = arr.get(0);

        int maxSubsequence = arr.get(0);

        for (int i = 1; i < arr.size(); i++) {

            int value = arr.get(i);

            // Maximum subarray (Kadane's Algorithm)
            current = Math.max(value, current + value);
            maxSubarray = Math.max(maxSubarray, current);

            // Maximum subsequence
            if (value > 0) {
                maxSubsequence += value;
            }
        }

        // If all numbers are negative
        if (maxSubsequence <= 0) {
            maxSubsequence = Collections.max(arr);
        }

        List<Integer> result = new ArrayList<>();
        result.add(maxSubarray);
        result.add(maxSubsequence);

        return result;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {

            int n = sc.nextInt();

            List<Integer> arr = new ArrayList<>();

            for (int i = 0; i < n; i++) {
                arr.add(sc.nextInt());
            }

            List<Integer> result = maxSubarray(arr);

            System.out.println(result.get(0) + " " + result.get(1));
        }

        sc.close();
    }
}
