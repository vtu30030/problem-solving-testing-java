import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int p = sc.nextInt();

        while (p-- > 0) {
            String s1 = sc.next();
            String s2 = sc.next();

            boolean found = false;

            for (int i = 0; i < s1.length(); i++) {
                if (s2.indexOf(s1.charAt(i)) != -1) {
                    found = true;
                    break;
                }
            }

            if (found)
                System.out.println("YES");
            else
                System.out.println("NO");
        }
    }
}
