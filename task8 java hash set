import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();

        Set<String> set = new HashSet<>();

        for (int i = 0; i < t; i++) {
            String a = sc.next();
            String b = sc.next();

            set.add(a + " " + b);
            System.out.println(set.size());
        }
        sc.close();
    }
}
